{
    "name": "freeline/pdv",
    "description": "Pacote Laravel do Simples PDV para uso standalone ou integrado ao ERP Freeline.",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "notagil/integration-sdk": "0.2.0"
    },
    "autoload": {
        "psr-4": {
            "Freeline\\Pdv\\": "src/"
        }
    },
    "scripts": {
        "release": "@php scripts/release.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Freeline\\Pdv\\PdvServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
